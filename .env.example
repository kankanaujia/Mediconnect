# Copy to .env.local and fill in real values. Never put real keys in this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Signs login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Email (password reset, booking confirmations) through https://resend.com.
# Without these, emails are printed to the server log instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=MediConnect <onboarding@resend.dev>
# Public URL used in email links, e.g. https://mediconnect.vercel.app
APP_URL=http://localhost:3000


NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=your-twilio-messaging-service-sid

# Protects the daily doctor-agenda job (Vercel Cron sends it automatically).
CRON_SECRET=replace-with-a-long-random-string
